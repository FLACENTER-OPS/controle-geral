function calculateDealDocumentStatus(docs){if(!docs.length)return'';return docs.every(d=>val(d.printed_status)==='ok'&&val(d.dealer_center_status)==='ok'&&['ok','complete'].includes(val(d.status)))?'complete':'pending'}function hasCriticalDocument(docs){return docs.some(d=>calculateDocumentStatus(d.printed_status,d.dealer_center_status)==='critical'||val(d.status)==='critical')}function calculateDocumentStatus(p,d){p=val(p||'pending');d=val(d||'pending');if(p==='missing'||d==='missing')return'critical';if(p==='ok'&&d==='ok')return'ok';return'pending'}function getAgingInfo(v){const d=toDateValue(v);if(!d)return null;const t=new Date(),start=new Date(d.getFullYear(),d.getMonth(),d.getDate()),end=new Date(t.getFullYear(),t.getMonth(),t.getDate()),days=Math.max(0,Math.floor((end-start)/86400000));return{days,tone:days<=21?'green':days<=45?'yellow':days<=60?'orange':'red'}}function calculateHealthScore(alerts,aging,docs){if(alerts.some(isCriticalAlert)||(aging&&aging.days>60)||hasCriticalDocument(docs))return'critical';if(alerts.length||(aging&&aging.days>21))return'attention';return'ok'}function calculateDashboardHealth(alerts,aging){if(alerts.some(isCriticalAlert)||(aging&&aging.days>=46))return'critical';if(alerts.length||(aging&&aging.days>=22))return'attention';return'ok'}function buildDmvSlaMetrics(deals){return deals.reduce((a,d)=>{const s=calculateDmvSlaStatus(d);if(val(d.dmv_status)==='with_dispatcher')a.with_dispatcher++;if(s==='due_today')a.due_today++;if(s==='overdue')a.overdue++;if(s==='escalated')a.escalated++;return a},{with_dispatcher:0,due_today:0,overdue:0,escalated:0})}function buildStatusMetrics(deals,field){return{pending:deals.filter(d=>val(d[field])==='pending').length,sent:deals.filter(d=>val(d[field])==='sent').length,done:deals.filter(d=>val(d[field])==='done').length,with_dispatcher:deals.filter(d=>val(d[field])==='with_dispatcher').length,rejected:deals.filter(d=>val(d[field])==='rejected').length,resubmission_needed:deals.filter(d=>val(d[field])==='resubmission_needed').length,pendingOver21:deals.filter(d=>val(d[field])==='pending'&&getAgingInfo(d.sale_date)&&getAgingInfo(d.sale_date).days>21).length,pendingOver45:deals.filter(d=>val(d[field])==='pending'&&getAgingInfo(d.sale_date)&&getAgingInfo(d.sale_date).days>45).length,pendingOver60:deals.filter(d=>val(d[field])==='pending'&&getAgingInfo(d.sale_date)&&getAgingInfo(d.sale_date).days>60).length}}function ensureOpenAlert(sheet,id,type,priority,status,now){const v=sheet.getDataRange().getValues();for(let i=1;i<v.length;i++)if(String(v[i][0])===String(id)&&String(v[i][1])===String(type)&&!isResolvedAlert(rowToObject(DEAL_ALERTS_HEADERS,v[i])))return;sheet.appendRow([id,type,priority||'high',status||'open',now||new Date().toISOString(),''])}function closeAlertsByTypes(sheet,id,types,now){const v=sheet.getDataRange().getValues();for(let i=1;i<v.length;i++){const a=rowToObject(DEAL_ALERTS_HEADERS,v[i]);if(String(a.deal_id)===String(id)&&types.includes(String(a.alert_type))&&!isResolvedAlert(a)){setCell(sheet,i+1,DEAL_ALERTS_HEADERS,'status','resolved');setCell(sheet,i+1,DEAL_ALERTS_HEADERS,'resolved_at',now||new Date().toISOString())}}}
function isCompletedMasterDeal(d){return val(d.dmv_status)==='done'||val(d.hub_status)==='completed'}function isArchivedMasterDeal(d){return val(d.hub_status)==='archived'}function isParceladoSim(d){return['sim','yes','true'].includes(val(d.parcelado))}function isPendingParcelamento(d){return isParceladoSim(d)&&!['created','done','complete','completed','not_needed'].includes(val(d.parcelamento_status))}function countDocumentStatuses(docs){return docs.reduce((a,d)=>{const s=calculateDocumentStatus(d.printed_status,d.dealer_center_status);a[s==='ok'?'ok':s==='critical'?'critical':'pending']++;return a},{ok:0,pending:0,critical:0})}function countCriticalDocuments(docs){return docs.filter(d=>calculateDocumentStatus(d.printed_status,d.dealer_center_status)==='critical').length}function countPendingDocuments(docs){return docs.reduce((a,d)=>{if(calculateDocumentStatus(d.printed_status,d.dealer_center_status)!=='ok')a[d.document_name||'Documento']=(a[d.document_name||'Documento']||0)+1;return a},{})}function buildSellerLeaderboard(active,alertsByDeal,docsByDeal){const sellers={};active.forEach(d=>{const s=d.seller||'Sem vendedor',alerts=alertsByDeal[String(d.deal_id)]||[],docs=docsByDeal[String(d.deal_id)]||[],aging=getAgingInfo(d.sale_date);if(!sellers[s])sellers[s]={seller:s,activeDeals:0,alerts:0,criticalAlerts:0,agingTotal:0,agingCount:0,criticalDocuments:0,completeDocs:0,docDeals:0};const x=sellers[s];x.activeDeals++;x.alerts+=alerts.length;x.criticalAlerts+=alerts.filter(isCriticalAlert).length;x.criticalDocuments+=countCriticalDocuments(docs);if(aging){x.agingTotal+=aging.days;x.agingCount++}if(docs.length){x.docDeals++;if(calculateDealDocumentStatus(docs)==='complete')x.completeDocs++}});return Object.keys(sellers).map(k=>{const x=sellers[k];return{seller:x.seller,activeDeals:x.activeDeals,alerts:x.alerts,criticalAlerts:x.criticalAlerts,averageAging:averageFromTotals(x.agingTotal,x.agingCount),criticalDocuments:x.criticalDocuments,documentationCompletePercent:percent(x.completeDocs,x.docDeals)}}).sort((a,b)=>(b.criticalAlerts+b.alerts+b.criticalDocuments)-(a.criticalAlerts+a.alerts+a.criticalDocuments))}function getCompletionDays(deal,history){const sale=toDateValue(deal.sale_date);if(!sale)return null;const done=history.filter(h=>String(h.deal_id)===String(deal.deal_id)).filter(h=>val(h.notes).indexOf('dmv_status = done')>=0||val(h.action).indexOf('dmv')>=0).map(h=>toDateValue(h.timestamp)).filter(Boolean).sort((a,b)=>a-b)[0],end=done||toDateValue(deal.updated_at);return end?Math.max(0,Math.floor((end-sale)/86400000)):null}function topUrgentAlerts(alerts,deals){const map=dealMap(deals);return alerts.slice().sort((a,b)=>alertPriorityRank(b,map)-alertPriorityRank(a,map)).slice(0,5).map(a=>({deal_id:a.deal_id||'',alert_type:a.alert_type||'',priority:a.priority||'',seller:(map[String(a.deal_id)]||{}).seller||'',created_at:a.created_at||''}))}function alertPriorityRank(a,map){const type=val(a.alert_type),aging=getAgingInfo((map[String(a.deal_id)]||{}).sale_date);let r=isCriticalAlert(a)?100:0;if(aging&&aging.days>60)r+=80;if(type.indexOf('dmv')>=0)r+=60;if(type.indexOf('parcel')>=0)r+=40;if(type.indexOf('document')>=0||type.indexOf('doc')>=0)r+=30;return r}function countAlertsBySeller(alerts,deals){const map=dealMap(deals);return alerts.reduce((a,x)=>{const s=(map[String(x.deal_id)]||{}).seller||'Sem vendedor';a[s]=(a[s]||0)+1;return a},{})}function dealMap(deals){return deals.reduce((a,d)=>(a[String(d.deal_id)]=d,a),{})}function groupBy(items,key){return items.reduce((a,x)=>{const v=String(x[key]||'');(a[v]=a[v]||[]).push(x);return a},{})}function countBy(items,key){return items.reduce((a,x)=>{const v=x[key]||'-';a[v]=(a[v]||0)+1;return a},{})}function objectToPairs(o){return Object.keys(o||{}).map(k=>({label:k,value:o[k]})).sort((a,b)=>b.value-a.value)}function slaRange(d){return d<=21?'ok':d<=45?'attention':d<=60?'risk':'critical'}function average(v){return v.length?round(v.reduce((s,x)=>s+x,0)/v.length,1):0}function averageFromTotals(t,c){return c?round(t/c,1):0}function percent(v,t){return t?Math.round(v/t*100):0}function round(v,d){const f=Math.pow(10,d||0);return Math.round(v*f)/f}function toDateValue(v){if(!v)return null;if(v instanceof Date)return isNaN(v.getTime())?null:v;if(typeof v==='number'){const d=new Date(Math.round((v-25569)*86400*1000));return isNaN(d.getTime())?null:d}const s=String(v).trim();if(!s)return null;let m=s.match(/^(\d{4})-(\d{2})-(\d{2})/);if(m)return new Date(+m[1],+m[2]-1,+m[3],12);m=s.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/);if(m)return new Date(+m[3],+m[1]-1,+m[2],12);const d=new Date(s);return isNaN(d.getTime())?null:d}function dateOnly(d){return new Date(d.getFullYear(),d.getMonth(),d.getDate())}function toIsoDate(d){return d?d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0'):''}function htmlEscape(v){return String(v||'').replace(/[&<>]/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[m]))}function stripHtml(v){return String(v||'').replace(/<[^>]+>/g,'')}function createNotificationId(){return Utilities.getUuid?Utilities.getUuid():'notif_'+new Date().getTime()+'_'+Math.floor(Math.random()*100000)}function isResolvedAlert(a){const s=val(a.status);return Boolean(a.resolved_at)||['resolved','resolvido','closed','fechado'].includes(s)}function isCriticalAlert(a){return['critical','critico','critico','high','alta'].includes(val(a.priority))}function dedupeActions(actions){const seen={};return actions.filter(a=>seen[a.action_id]?false:(seen[a.action_id]=true))}function normalizeActionKey(v){return String(v||'doc').toLowerCase().replace(/[^a-z0-9]+/g,'_').replace(/^_+|_+$/g,'')||'doc'}function actionPriorityWeight(p){return{critical:4,high:3,medium:2,low:1}[val(p)]||0}function pick(){for(let i=0;i<arguments.length;i++)if(arguments[i]!==undefined&&arguments[i]!==null&&arguments[i]!=='')return arguments[i];return''}function val(v){return String(v||'').toLowerCase()}function jsonOutput(data){return ContentService.createTextOutput(JSON.stringify(data)).setMimeType(ContentService.MimeType.JSON)}