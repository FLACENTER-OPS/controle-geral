function calculateDealDocumentStatus(docs){if(!docs.length)return'';return docs.every(d=>val(d.printed_status)==='ok'&&val(d.dealer_center_status)==='ok'&&['ok','complete'].includes(val(d.status)))?'complete':'pending'}function hasCriticalDocument(docs){return docs.some(d=>calculateDocumentStatus(d.printed_status,d.dealer_center_status)==='critical'||val(d.status)==='critical')}function calculateDocumentStatus(p,d){p=val(p||'pending');d=val(d||'pending');if(p==='missing'||d==='missing')return'critical';if(p==='ok'&&d==='ok')return'ok';return'pending'}function countDocumentStatuses(docs){return docs.reduce((a,d)=>{a[calculateDocumentStatus(d.printed_status,d.dealer_center_status)]++;return a},{ok:0,pending:0,critical:0})}function countPendingDocuments(docs){return docs.reduce((a,d)=>{if(calculateDocumentStatus(d.printed_status,d.dealer_center_status)!=='ok')a[d.document_name||'Documento']=(a[d.document_name||'Documento']||0)+1;return a},{})}
function getAgingInfo(v){const d=toDateValue(v);if(!d)return null;const t=new Date(),days=Math.max(0,Math.floor((dateOnly(t)-dateOnly(d))/86400000));return{days,tone:days<=21?'green':days<=45?'yellow':days<=60?'orange':'red'}}function hasCriticalHealthAlert(alerts){return(alerts||[]).some(a=>['critical','critico','crítico'].includes(val(a.priority)))}function hasHighHealthAlert(alerts){return(alerts||[]).some(a=>['high','alta'].includes(val(a.priority)))}function calculateHealthScore(alerts,aging,docs){if(hasCriticalHealthAlert(alerts)||(aging&&aging.days>60))return'critical';if(hasHighHealthAlert(alerts)||(aging&&aging.days>=46&&aging.days<=60))return'risk';if((alerts||[]).length||(aging&&aging.days>=22&&aging.days<=45))return'attention';return'ok'}function calculateDashboardHealth(alerts,aging){if(hasCriticalHealthAlert(alerts)||(aging&&aging.days>60))return'critical';if(hasHighHealthAlert(alerts)||(aging&&aging.days>=46&&aging.days<=60))return'risk';if((alerts||[]).length||(aging&&aging.days>=22&&aging.days<=45))return'attention';return'ok'}function buildDmvSlaMetrics(deals){return deals.reduce((a,d)=>{const s=calculateDmvSlaStatus(d);if(val(d.dmv_status)==='with_dispatcher')a.with_dispatcher++;if(a[s]!==undefined)a[s]++;return a},{with_dispatcher:0,due_today:0,overdue:0,escalated:0})}function buildStatusMetrics(deals,field){return{pending:deals.filter(d=>val(d[field])==='pending').length,sent:deals.filter(d=>val(d[field])==='sent').length,done:deals.filter(d=>val(d[field])==='done').length,with_dispatcher:deals.filter(d=>val(d[field])==='with_dispatcher').length,rejected:deals.filter(d=>val(d[field])==='rejected').length,resubmission_needed:deals.filter(d=>val(d[field])==='resubmission_needed').length}}
function isCompletedMasterDeal(d){return val(d.dmv_status)==='done'||val(d.hub_status)==='completed'}function isArchivedMasterDeal(d){return val(d.hub_status)==='archived'}function isParceladoSim(d){return['sim','yes','true'].includes(val(d.parcelado))}function isPendingParcelamento(d){return isParceladoSim(d)&&!['created','done','complete','completed','not_needed'].includes(val(d.parcelamento_status))}function isResolvedAlert(a){const s=val(a.status);return Boolean(a.resolved_at)||['resolved','resolvido','closed','fechado'].includes(s)}function isCriticalAlert(a){return['critical','critico','crítico','high','alta'].includes(val(a.priority))}
function buildSellerLeaderboard(active,alertsByDeal,docsByDeal){const o={};active.forEach(d=>{const s=d.seller||'Sem vendedor',a=alertsByDeal[String(d.deal_id)]||[],docs=docsByDeal[String(d.deal_id)]||[];if(!o[s])o[s]={seller:s,activeDeals:0,alerts:0,criticalAlerts:0,criticalDocuments:0};o[s].activeDeals++;o[s].alerts+=a.length;o[s].criticalAlerts+=a.filter(isCriticalAlert).length;o[s].criticalDocuments+=docs.filter(hasCriticalDocument).length});return Object.keys(o).map(k=>o[k]).sort((a,b)=>(b.alerts+b.criticalDocuments)-(a.alerts+a.criticalDocuments))}
function groupBy(items,key){return items.reduce((a,x)=>{const v=String(x[key]||'');(a[v]=a[v]||[]).push(x);return a},{})}function countBy(items,key){return items.reduce((a,x)=>{const v=x[key]||'-';a[v]=(a[v]||0)+1;return a},{})}function objectToPairs(o){return Object.keys(o||{}).map(k=>({label:k,value:o[k]})).sort((a,b)=>b.value-a.value)}function slaRange(d){return d<=21?'ok':d<=45?'attention':d<=60?'risk':'critical'}function average(v){return v.length?round(v.reduce((s,x)=>s+x,0)/v.length,1):0}function percent(v,t){return t?Math.round(v/t*100):0}function round(v,d){const f=Math.pow(10,d||0);return Math.round(v*f)/f}function toDateValue(v){if(!v)return null;if(v instanceof Date)return isNaN(v.getTime())?null:v;if(typeof v==='number')return new Date(Math.round((v-25569)*86400*1000));const s=String(v).trim();let m=s.match(/^(\d{4})-(\d{2})-(\d{2})/);if(m)return new Date(+m[1],+m[2]-1,+m[3],12);m=s.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/);if(m)return new Date(+m[3],+m[1]-1,+m[2],12);const d=new Date(s);return isNaN(d.getTime())?null:d}function dateOnly(d){return new Date(d.getFullYear(),d.getMonth(),d.getDate())}function toIsoDate(d){return d?d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0'):''}function createNotificationId(){return Utilities.getUuid?Utilities.getUuid():'notif_'+Date.now()+'_'+Math.floor(Math.random()*100000)}function dedupeActions(actions){const seen={};return actions.filter(a=>seen[a.action_id]?false:(seen[a.action_id]=true))}function normalizeActionKey(v){return String(v||'doc').toLowerCase().replace(/[^a-z0-9]+/g,'_').replace(/^_+|_+$/g,'')||'doc'}function actionPriorityWeight(p){return{critical:4,high:3,medium:2,low:1}[val(p)]||0}function val(v){return String(v||'').toLowerCase()}function jsonOutput(data){return ContentService.createTextOutput(JSON.stringify(data)).setMimeType(ContentService.MimeType.JSON)}