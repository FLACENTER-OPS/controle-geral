function getCentralSpreadsheet(){const id=getConfigValue('CENTRAL_DB_ID');if(!id)throw new Error('CENTRAL_DB_ID nao configurado nas Script Properties.');return SpreadsheetApp.openById(id)}function ensureSheet(ss,name,headers){let sh=ss.getSheetByName(name);if(!sh)sh=ss.insertSheet(name);if(sh.getLastRow()===0){sh.appendRow(headers);sh.setFrozenRows(1);return sh}const cur=sh.getRange(1,1,1,Math.max(sh.getLastColumn(),headers.length)).getValues()[0].map(String);headers.forEach(h=>{if(!cur.includes(h))sh.getRange(1,sh.getLastColumn()+1).setValue(h)});sh.setFrozenRows(1);return sh}function getSheetRows(sheet){const v=sheet.getDataRange().getValues();if(v.length<2)return[];const h=v[0].map(String);return v.slice(1).filter(r=>r.some(c=>c!==''&&c!==null)).map(r=>rowToObject(h,r))}function getDealMasterRows(sheet){return getSheetRows(sheet).filter(r=>r.deal_id).sort((a,b)=>String(b.updated_at||b.created_at||'').localeCompare(String(a.updated_at||a.created_at||'')))}function getOpenAlertsByDeal(sheet){const out={};getSheetRows(sheet).forEach(a=>{const id=String(a.deal_id||'');if(!id||isResolvedAlert(a))return;(out[id]=out[id]||[]).push(a)});return out}function getDealMasterById(sheet,id){return getSheetRows(sheet).find(r=>String(r.deal_id)===String(id))||null}function getRowsByDealId(sheet,id){return getSheetRows(sheet).filter(r=>String(r.deal_id)===String(id))}function findDealMasterRow(sheet,id){const v=sheet.getDataRange().getValues();for(let i=1;i<v.length;i++)if(String(v[i][0])===String(id))return i+1;return-1}function findDealDocumentRow(sheet,id,name){const v=sheet.getDataRange().getValues();for(let i=1;i<v.length;i++)if(String(v[i][0])===String(id)&&String(v[i][1])===String(name))return i+1;return-1}function setCell(sheet,row,headers,field,value){const h=sheet.getRange(1,1,1,Math.max(sheet.getLastColumn(),headers.length)).getValues()[0].map(String);const col=h.indexOf(field)+1;if(col>0)sheet.getRange(row,col).setValue(value)}function setMasterField(sheet,row,field,va