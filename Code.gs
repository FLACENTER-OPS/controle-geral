function getCentralSpreadsheet(){const id=getConfigValue('CENTRAL_DB_ID');if(!id)throw new Error('CENTRAL_DB_ID nao configurado nas Script Properties.');return SpreadsheetApp.openById(id)}function getConfigValue(k){return PropertiesService.getScriptProperties().getProperty(k)}function ensureSheet(ss,name,headers){let sh=ss.getSheetByName(name);if(!sh)sh=ss.insertSheet(name);if(sh.getLastRow()===0){sh.appendRow(headers);sh.setFrozenRows(1);return sh}const cur=getHeaders(sh);headers.forEach(h=>{if(!cur.includes(h))sh.getRange(1,sh.getLastColumn()+1).setValue(h)});sh.setFrozenRows(1);return sh}function getHeaders(sh){return sh.getRange(1,1,1,Math.max(sh.getLastColumn(),1)).getValues()[0].map(String)}function getSheetRows(sh){const v=sh.getDataRange().getValues();if(v.length<2)return[];const h=v[0].map(String);return v.slice(1).filter(r=>r.some(c=>c!==''&&c!==null)).map(r=>rowToObject(h,r))}function rowToObject(h,row){return h.reduce((a,k,i)=>(a[k]=row[i]===undefined?'':row[i],a),{})}function writeRow(sh,row,headers,obj){ensureSheet(sh.getParent(),sh.getName(),headers);const h=getHeaders(sh),values=h.map(k=>obj[k]!==undefined?obj[k]:'');if(row>0)sh.getRange(row,1,1,values.length).setValues([values]);else sh.appendRow(values)}function setCell(sh,row,headers,field,value){const h=getHeaders(sh),col=h.indexOf(field)+1;if(col>0)sh.getRange(row,col).setValue(value)}function setMasterField(sh,row,field,value){setCell(sh,row,DEAL_MASTER_HEADERS,field,value)}function appendHistory(sh,id,action,user,notes){sh.appendRow([id||'',action||'',user||'',notes||'',new Date().toISOString()])}
